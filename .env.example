# ============================================================
# 复制本文件为 .env 后填入自己的值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交
# ============================================================

# MySQL root 密码（首次启动时写入数据卷，后续修改不会生效）
MYSQL_ROOT_PASSWORD=change-me-please

# Redis 密码
REDIS_PASSWORD=change-me-please

# JWT 签名密钥：>=64 位随机串
# 生成方式：openssl rand -hex 48
JWT_SECRET=change-me-please-use-a-64-char-random-string

# 站点对外地址：邮件模板、分享链接、图片直链前缀
# 本地开发可留空（默认 http://localhost:8091）；上线后填 https://coolskyai.com
BLOG_VIEW=
SITE_URL=

# 邮件服务（可选）：不填则发信功能不可用，不影响其他功能
MAIL_PASSWORD=

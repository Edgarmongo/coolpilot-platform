# ============================================================
# 复制本文件为 .env 后填入自己的值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交
# ============================================================

# MySQL root 密码（首次启动时写入数据卷，后续修改不会生效）
MYSQL_ROOT_PASSWORD=change-me-please

# Redis 密码
REDIS_PASSWORD=change-me-please

# JWT 签名密钥：>=64 位随机串
# 生成方式：openssl rand -hex 48
JWT_SECRET=change-me-please-use-a-64-char-random-string

# 站点对外地址：邮件模板、分享链接、图片直链前缀
# 本地开发可留空（默认 http://localhost:8091）；上线后填 https://coolskyai.com
BLOG_VIEW=
SITE_URL=

# 邮件服务（可选）：不填则发信功能不可用，不影响其他功能
MAIL_PASSWORD=

# 是否信任 X-Forwarded-For（默认 false）
# 只有反向代理会「覆盖」该头时才打开，否则限流/友链去重可被伪造头绕过
# 详见 docs/CI-CD.md「统一入口与真实 IP」
SECURITY_TRUST_FORWARDED_FOR=false

# 生产入口域名（gateway 的 server_name），多个用空格分隔
# 多个域名时必须加引号：scripts/backup.sh 会 source 这个文件，
# 不加引号 bash 会把第二个域名当成命令执行而失败
SERVER_NAME="coolskyai.com www.coolskyai.com"

# 通知邮件里「去后台处理」的链接前缀（默认 ${SITE_URL}/cms）
# BLOG_CMS=https://coolskyai.com/cms

# 大模型（OpenAI 兼容协议），留空则问答只返回检索片段
# 本地 Ollama:  AI_LLM_BASE_URL=http://host.docker.internal:11434/v1  AI_LLM_MODEL=qwen2.5:7b
# DeepSeek:     AI_LLM_BASE_URL=https://api.deepseek.com/v1  AI_LLM_MODEL=deepseek-flash（另有 deepseek-v4-pro）
# 通义千问:      AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_LLM_MODEL=qwen-plus
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=
# 厂商专有参数（JSON 字符串）
# DeepSeek V4 默认开启思考模式，只要正文时填：{"thinking":{"type":"disabled"}}
AI_LLM_EXTRA_BODY=

# 向量模型：hashing（默认，离线字面召回）或 openai（任意 OpenAI 兼容 /embeddings）
# 本地 Ollama: AI_EMBEDDING_PROVIDER=openai  AI_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1  AI_EMBEDDING_MODEL=bge-m3  AI_EMBEDDING_DIM=1024
# 换 provider / dim 之后必须重建索引
AI_EMBEDDING_PROVIDER=hashing
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=1024

# 混合检索：向量得分权重，其余给关键词匹配
AI_SEARCH_HYBRID_ALPHA=0.65
# 检索结果最低分（搜索页与问答共用同一把尺子）
AI_SEARCH_MIN_SCORE=0.25
AI_CHAT_MIN_SCORE=0.25

# 追问改写：会话里的「那退款呢」先补全成独立问题再检索
AI_CHAT_REWRITE=true
AI_CHAT_REWRITE_HISTORY=3      # 带进 prompt 的历史轮数（用改写后的句子）
AI_CHAT_REWRITE_ANSWER_ROUNDS=2 # 带进 prompt 的回答轮数（序号指代常指向更早那条）
AI_CHAT_REWRITE_ANSWER=300      # 单条回答节选长度（≈列表前三条），0=不用回答内容
AI_CHAT_REWRITE_ANSWER_BUDGET=600  # 回答节选总预算，超出按轮数均分
AI_CHAT_REWRITE_MAX_ROUNDS=5    # 首次没解开时最多回溯几轮
AI_CHAT_REWRITE_ESCALATE=true   # 是否允许回溯升级
AI_CHAT_REWRITE_CACHE=3600     # 改写结果缓存秒数

# 重排：none（默认）/ llm（用对话模型排序，无需额外模型）/ http（bge-reranker 服务）
# http 示例：AI_RERANK_BASE_URL=http://host.docker.internal:8080  AI_RERANK_MODEL=bge-reranker-v2-m3
AI_RERANK_PROVIDER=none
AI_RERANK_BASE_URL=
AI_RERANK_API_KEY=
AI_RERANK_MODEL=bge-reranker-v2-m3
AI_RERANK_CANDIDATES=20
# 严格度：strict（只留能直接回答的）/ balanced（默认）/ loose（宁多勿漏）
AI_RERANK_STRICTNESS=balanced
AI_RERANK_MIN_KEEP=            # 留空=按严格度推导；填数字则覆盖
AI_RERANK_SCORE_MODE=auto      # auto / logit / probability（logits 自动过 sigmoid）
AI_RERANK_RELATIVE_FLOOR=      # 留空=按严格度推导；0=关闭，填数则覆盖
AI_RERANK_MIN_SCORE=0          # 绝对下限（0~1），确定要卡线时才填
AI_RERANK_CACHE=900            # 重排结果缓存秒数
